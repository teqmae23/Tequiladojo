rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── ロール判定 ─────────────────────────────────────────────
    // 1) Custom Claims（functions/setCustomClaims が members.role から同期）
    // 2) フォールバック: staffRoles/{uid} ドキュメント
    //    → どちらかで owner/staff なら許可（claims未反映でも締め出さない）
    function signedIn() { return request.auth != null; }
    function realUser() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function claimRole() {
      return signedIn() ? request.auth.token.get('role', '') : '';
    }
    function docRole() {
      return exists(/databases/$(database)/documents/staffRoles/$(request.auth.uid))
        ? get(/databases/$(database)/documents/staffRoles/$(request.auth.uid)).data.get('role', '')
        : '';
    }
    function isOwner() {
      return signedIn() && (claimRole() == 'owner' || docRole() == 'owner');
    }
    function isStaff() {
      return signedIn()
        && (claimRole() in ['owner', 'staff'] || docRole() in ['owner', 'staff']);
    }
    // ブラインド: 当該バッチの会員入力が「許可中」か（店の inputOpen フラグ）
    function flightInputOpen(bid) {
      return exists(/databases/$(database)/documents/blindFlights/$(bid))
        && get(/databases/$(database)/documents/blindFlights/$(bid)).data.get('inputOpen', false) == true;
    }
    // イベントアンケートの結果公開範囲（all/respondents/staff）
    function surveyVisibility(eid, sid) {
      return get(/databases/$(database)/documents/events/$(eid)/surveys/$(sid))
        .data.get('resultVisibility', 'staff');
    }
    // 参加をクライアントが自動承認(approved)にしてよいイベントか
    // （承認不要＝joinApproval!='manual' かつ 無料＝paidEvent!=true のときのみ）
    function evAllowsAutoApprove(eid) {
      return get(/databases/$(database)/documents/events/$(eid)).data.get('joinApproval','auto') != 'manual'
        && get(/databases/$(database)/documents/events/$(eid)).data.get('paidEvent', false) != true;
    }
    // 閲覧申請をクライアントが自動承認にしてよいイベントか（viewApproval!='manual'）
    function evViewAutoApprove(eid) {
      return get(/databases/$(database)/documents/events/$(eid)).data.get('viewApproval','auto') != 'manual';
    }

    // ── 会員情報（個人情報）: スタッフ全件 / 会員は自分のみ ─────
    // 作成・引継はCloud Functions（registerMember）がサーバー権限で行う
    match /members/{id} {
      allow read: if isStaff()
        || (realUser() && resource.data.get('authUid', '') == request.auth.uid);
      allow create: if isStaff();
      // 本人更新はプロフィール項目のみ。role等の保護フィールドは変更不可
      // （members.roleはsetCustomClaimsトリガーでAuth権限に同期されるため、
      //   本人がroleを書けると権限昇格できてしまう）
      allow update: if isStaff()
        || (realUser() && resource.data.get('authUid', '') == request.auth.uid
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(
                 ['role', 'authUid', 'realId', 'displayId', 'memberId',
                  'visitCount', 'totalAmount', 'totalTequila', 'rank',
                  'deleted', 'deletedAt', 'badgeCollectionUrl',
                  'plan', 'grade', 'subscriptionStatus', 'subscriptionPeriodEnd',
                  'subscriptionPlanId', 'cancelAtPeriodEnd',
                  'stripeCustomerId', 'stripeSubscriptionId',
                  'depositEnabled', 'depositBalance', 'tabBalance'].toSet()));
      allow delete: if isOwner();
    }

    // memberIndex: 会員ID→メール解決はFunctions（loginWithMemberId）が行うため
    // クライアントからはスタッフのみ（公開getはメール列挙につながるため廃止）
    match /memberIndex/{id} {
      allow read, write: if isStaff();
    }

    // memberPrivate: 会員のオーナー管理情報（目印写真URL・note・備考）。
    // 本人には読ませない。スタッフは閲覧のみ、編集（写真/note/備考）はオーナーのみ。
    match /memberPrivate/{id} {
      allow read: if isStaff();
      allow write: if isOwner();
    }

    // tempRegistrations: 引継コードの検証・消込はFunctions（registerMember）が行う
    match /tempRegistrations/{code} {
      allow read, write: if isStaff();
    }

    // ジャーナル（操作証跡）: スタッフのみ作成・閲覧、削除はオーナーのみ、改変不可
    match /journals/{id} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update: if false;
      allow delete: if isOwner();
    }

    // 会員のページアクセスログ: 会員本人は作成のみ（読取不可）。閲覧・整理はスタッフ/オーナー。
    // 作成時は authUid を本人に固定し、想定フィールド以外は書かせない。
    match /accessLogs/{id} {
      allow read: if isStaff();
      allow create: if realUser()
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['memberId', 'name', 'page', 'authUid', 'at']);
      allow update: if false;
      allow delete: if isOwner();
    }

    // TOPページのアクセス集計（Cloud Functions が admin SDK で書込＝ルールをバイパス）。
    // クライアントからの書込は禁止し、閲覧のみスタッフに許可する。
    match /topAccessLogs/{id} {
      allow read: if isStaff();
      allow write: if false;
    }

    // 会員向けイベントマスタ: 公開中(published=true)は会員も閲覧可。追加/編集/削除はスタッフ。
    match /events/{id} {
      allow read: if isStaff() || (signedIn() && resource.data.get('published', false) == true);
      allow write: if isStaff();

      // イベント配下のアンケート定義: 認証会員は閲覧可（表示可否は status/公開範囲でアプリ側制御）、
      // 編集はスタッフ。
      match /surveys/{sid} {
        allow read: if signedIn();
        allow write: if isStaff();

        // アンケート回答: 1会員1件（docID=authUid）。本人のみ作成・更新・削除。
        // 読み取りは結果公開範囲(resultVisibility)に応じて制御する:
        //   staff       → スタッフのみ（会員は自分の回答だけ読める）
        //   respondents → 回答済みの会員は全回答を閲覧可
        //   all         → 認証会員全員が全回答を閲覧可
        match /responses/{uid} {
          allow read: if isStaff()
            || (signedIn() && request.auth.uid == uid)
            || (signedIn() && surveyVisibility(id, sid) == 'all')
            || (signedIn() && surveyVisibility(id, sid) == 'respondents'
                && exists(/databases/$(database)/documents/events/$(id)/surveys/$(sid)/responses/$(request.auth.uid)));
          allow create, update: if isStaff()
            || (realUser() && request.auth.uid == uid
                && request.resource.data.get('authUid', '') == request.auth.uid);
          allow delete: if isStaff() || (realUser() && request.auth.uid == uid);
        }
      }

      // スケジュール/タイムテーブル項目: 認証会員は閲覧可、編集はスタッフ。
      match /scheduleItems/{iid} {
        allow read: if signedIn();
        allow write: if isStaff();
      }

      // イベント写真: 会員は閲覧可。実会員(本人)がアップロード、削除は本人かスタッフ。
      match /photos/{pid} {
        allow read: if signedIn();
        allow create: if realUser()
          && request.resource.data.get('uploaderUid', '') == request.auth.uid;
        allow update, delete: if isStaff()
          || (realUser() && resource.data.get('uploaderUid', '') == request.auth.uid);
      }

      // チェックリスト項目: 認証会員は閲覧可、編集はスタッフ。
      // 完了状況(docID=authUid): 本人が作成・更新・取消、スタッフは全操作可、会員間で閲覧可(公開項目の共有用)。
      match /tasks/{tid} {
        allow read: if signedIn();
        allow write: if isStaff();
        match /completions/{uid} {
          allow read: if signedIn();
          // 本人は作成・更新可。ただしファイル承認(approved)またはメッセージ承認
          // (msgApproved)が付いたら本人は変更・取消できない。解除はスタッフのみ。
          allow create, update: if isStaff()
            || (realUser() && request.auth.uid == uid
                && request.resource.data.get('authUid', '') == request.auth.uid
                && (resource == null || (resource.data.get('approved', false) != true && resource.data.get('msgApproved', false) != true)));
          allow delete: if isStaff()
            || (realUser() && request.auth.uid == uid
                && resource.data.get('approved', false) != true && resource.data.get('msgApproved', false) != true);
        }
      }

      // ドキュメント保管庫: 発行(issued)は会員全員が閲覧、提出(submission)は本人と
      // スタッフのみ閲覧。発行の作成/編集/削除はスタッフ。提出は本人が作成、
      // 本人orスタッフが更新/削除。
      match /documents/{did} {
        allow read: if isStaff()
          || (signedIn() && resource.data.get('category', 'issued') == 'issued')
          || (realUser() && resource.data.get('uploaderUid', '') == request.auth.uid);
        allow create: if isStaff()
          || (realUser() && request.resource.data.get('category', '') == 'submission'
              && request.resource.data.get('uploaderUid', '') == request.auth.uid);
        // 本人は自分の提出を更新/削除可。ただし承認済み(approved==true)は本人不可（スタッフのみ）。
        allow update, delete: if isStaff()
          || (realUser() && resource.data.get('uploaderUid', '') == request.auth.uid
              && resource.data.get('approved', false) != true);
      }

      // ツリー掲示板（⑥）: 参加会員（匿名不可）が投稿。公開済みは会員が閲覧可、
      // 承認待ちは本人とスタッフのみ閲覧可。編集・削除・承認はスタッフのみ。
      match /posts/{pid} {
        allow read: if isStaff()
          || (signedIn() && resource.data.get('status', 'published') == 'published')
          || (realUser() && resource.data.get('authorUid', '') == request.auth.uid);
        allow create: if realUser()
          && request.resource.data.get('authorUid', '') == request.auth.uid
          && request.resource.data.get('status', '') in ['published', 'pending'];
        allow update, delete: if isStaff();
      }

      // 参加者プロフィール（docID=authUid）: 認証会員は名簿として閲覧可。
      // 本人が自己登録・編集・取消（authUidを本人に固定）。スタッフは全操作可。
      match /participants/{uid} {
        allow read: if signedIn();
        // 会員は自分の参加docのみ。status を 'approved' にできるのは
        // 承認不要＆無料イベントのときだけ（それ以外は 'pending' で申請）。
        // 既存 status の維持は許可（承認済み参加者のプロフィール編集）。
        allow create: if isStaff()
          || (realUser() && request.auth.uid == uid
              && request.resource.data.get('authUid', '') == request.auth.uid
              && (request.resource.data.get('status','approved') == 'pending' || evAllowsAutoApprove(id)));
        allow update: if isStaff()
          || (realUser() && request.auth.uid == uid
              && request.resource.data.get('authUid', '') == request.auth.uid
              && (request.resource.data.get('status', resource.data.get('status','approved')) == resource.data.get('status','approved')
                  || request.resource.data.get('status','approved') == 'pending'
                  || evAllowsAutoApprove(id)));
        allow delete: if isStaff() || (realUser() && request.auth.uid == uid);
      }
      // 参加者による招待（会員が作成→管理者が承認）
      match /participantInvites/{iid} {
        allow read: if isStaff() || (realUser() && resource.data.get('invitedBy','') == request.auth.uid);
        allow create: if realUser()
          && request.resource.data.get('invitedBy','') == request.auth.uid
          && request.resource.data.get('status','') == 'pending';
        allow update, delete: if isStaff();
      }
      // 閲覧申請（会員が作成→承認不要なら approved、承認制は pending→管理者承認）
      match /viewRequests/{uid} {
        allow read: if signedIn();
        allow create: if isStaff()
          || (realUser() && request.auth.uid == uid
              && (request.resource.data.get('status','approved') == 'pending' || evViewAutoApprove(id)));
        allow update: if isStaff()
          || (realUser() && request.auth.uid == uid
              && (request.resource.data.get('status', resource.data.get('status','pending')) == resource.data.get('status','pending')
                  || request.resource.data.get('status','approved') == 'pending'
                  || evViewAutoApprove(id)));
        allow delete: if isStaff() || (realUser() && request.auth.uid == uid);
      }
      // 家族閲覧の招待（参加者が作成→管理者が承認）
      // 重複チェック（他の参加者の招待済み確認）のため read は署名済みに開放。
      match /familyInvites/{iid} {
        allow read: if signedIn();
        allow create: if realUser()
          && request.resource.data.get('invitedBy','') == request.auth.uid
          && request.resource.data.get('status','') == 'pending';
        allow update, delete: if isStaff();
      }
      // 参加者の自己紹介プロフィール（docID=authUid）。参加状況とは独立。
      // 認証会員は全員分を閲覧可。本人のみ作成・編集・削除（authUidを本人に固定）。
      match /profiles/{uid} {
        allow read: if signedIn();
        allow create, update: if isStaff()
          || (realUser() && request.auth.uid == uid
              && request.resource.data.get('authUid', '') == request.auth.uid);
        allow delete: if isStaff() || (realUser() && request.auth.uid == uid);
      }
    }

    // ニュースの既読/未読（会員ごと）。本人のみ読み書き可（doc IDは authUid）。
    match /newsReads/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if realUser() && request.auth.uid == uid;
    }

    match /attendance/{id} { allow read, write: if isStaff(); }
    match /reservations/{id} { allow read, write: if isStaff(); }

    // イベントスケジュール用の場所ライブラリ（登録済み地点の再利用）。閲覧は会員、編集はスタッフ。
    match /places/{id} {
      allow read: if signedIn();
      allow write: if isStaff();
    }

    // スケジュール種別（名前・アイコン・背景色）。閲覧は会員、編集はスタッフ。
    match /scheduleCategories/{id} {
      allow read: if signedIn();
      allow write: if isStaff();
    }

    // 会員セルフ来場予約リクエスト（承認制）。
    // 会員本人が自分の申請を作成／閲覧／取消（pendingのみ）でき、
    // 承認・却下（確定予約の作成は reservations 側）はスタッフが行う。
    // 作成時は authUid を本人に固定し、status=pending・想定フィールドのみ許可。
    match /reservationRequests/{id} {
      allow read: if isStaff()
        || (realUser() && resource.data.get('authUid', '') == request.auth.uid);
      allow create: if realUser()
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.get('status', '') == 'pending'
        && request.resource.data.keys().hasOnly(
             ['authUid', 'memberId', 'memberName', 'reservationDate',
              'startTime', 'endTime', 'guests', 'memo', 'status', 'createdAt'])
        && request.resource.data.reservationDate is string
        && request.resource.data.guests is int
        && request.resource.data.guests > 0
        && request.resource.data.guests <= 50;
      allow update: if isStaff();
      allow delete: if isStaff()
        || (realUser() && resource.data.get('authUid', '') == request.auth.uid
            && resource.data.get('status', '') == 'pending');
    }
    match /staffRoles/{uid} {
      allow read: if isStaff() || (signedIn() && request.auth.uid == uid);
      allow write: if isOwner();
    }

    // 個人テキーラログ（有料会員の飲酒記録）。本人のみ閲覧、手入力(source=manual)の
    // 作成・編集・削除が可能。道場自動記録(source=auto)はスタッフ/Functionsが作成し、
    // 本人は note/rating のみ編集可・削除不可。（有料判定はクライアント側で制御）
    match /tequilaLogs/{id} {
      allow read: if isStaff()
        || (realUser() && resource.data.get('authUid', '') == request.auth.uid);
      allow create: if realUser()
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.get('source', 'manual') == 'manual'
        && request.resource.data.keys().hasOnly(
             ['authUid', 'memberId', 'memberName', 'drunkAt', 'drunkAtLocal', 'tz',
              'bottleId', 'bottleName', 'style', 'amountMl', 'barId', 'barText',
              'note', 'rating', 'source', 'orderRef', 'createdAt', 'updatedAt'])
        && request.resource.data.amountMl is number
        && request.resource.data.rating is number
        && request.resource.data.rating >= 0 && request.resource.data.rating <= 5;
      allow update: if isStaff()
        || (realUser() && resource.data.get('authUid', '') == request.auth.uid
            && request.resource.data.authUid == resource.data.authUid
            && request.resource.data.get('source', 'manual') == resource.data.get('source', 'manual')
            && (resource.data.get('source', 'manual') == 'manual'
                ? !request.resource.data.diff(resource.data).affectedKeys()
                    .hasAny(['authUid', 'memberId', 'source', 'orderRef', 'createdAt'])
                : request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['note', 'rating', 'updatedAt'])));
      allow delete: if isStaff()
        || (realUser() && resource.data.get('authUid', '') == request.auth.uid
            && resource.data.get('source', 'manual') == 'manual');
    }

    // ボトル登録依頼（マスタ未登録の銘柄を会員が申請）。本人が pending 作成、
    // 本人／スタッフ閲覧、登録(bottleId付与)・却下はスタッフ。
    match /bottleRequests/{id} {
      allow read: if isStaff()
        || (realUser() && resource.data.get('authUid', '') == request.auth.uid);
      allow create: if realUser()
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.get('status', '') == 'pending'
        && request.resource.data.keys().hasOnly(
             ['authUid', 'memberId', 'memberName', 'name', 'note',
              'status', 'bottleId', 'createdAt', 'updatedAt']);
      allow update, delete: if isStaff();
    }

    // ── 日常業務（開店閉店・来場退場・注文・会計）: スタッフのみ ──
    // 会員向けページはCloud Functions（getMemberActivity / getStoreStatus）経由で
    // 本人分・公開情報のみ取得する
    match /visits/{id}        { allow read, write: if isStaff(); }
    match /orders/{id}        { allow read, write: if isStaff(); }
    // 店頭カード決済（WisePad 3）: 会計画面が決済リクエストを作成し、
    // Terminal SDK搭載アプリが処理・結果を書き戻す。いずれもスタッフのみ。
    match /terminalPayments/{id} { allow read, write: if isStaff(); }
    // 会員セルフ来店リクエスト（QR）。会員の作成・会員/スタッフの読取・承認は
    // Cloud Functions（requestCheckin）とスタッフ画面が担うため、直接操作はスタッフのみ。
    match /checkinRequests/{id} { allow read, write: if isStaff(); }
    // デポジット(前払金)・ツケ(未収)の入出金履歴: スタッフのみ。
    // 会員本人のマイページ履歴表示は Cloud Function 経由（残高は members ドキュメントから本人が読める）。
    match /depositData/{id}   { allow read, write: if isStaff(); }
    match /tabData/{id}       { allow read, write: if isStaff(); }
    // キープボトル（会員が店に預ける購入済みボトル）と利用履歴: スタッフのみ
    match /keepBottles/{id}   { allow read, write: if isStaff(); }
    match /keepBottleLog/{id} { allow read, write: if isStaff(); }
    match /cocktailOrders/{id}{ allow read, write: if isStaff(); }
    // ネットショップ参考相場（管理画面のみ・会員非公開）と、未紐付けの保留リスト
    match /marketPrices/{id}  { allow read, write: if isStaff(); }
    match /marketStaging/{id} { allow read, write: if isStaff(); }
    match /marketIntl/{id}    { allow read, write: if isStaff(); }
    match /marketIntlHistory/{id} { allow read, write: if isStaff(); }
    match /blindResults/{id}  { allow read, write: if isStaff(); }
    // ブラインド: 会員が自分の回答を入力する一時データ。店側が拾って blindResults に確定保存する。
    // 会員は自分(authUid一致)の doc のみ作成/更新できる。可否は店の入力許可(inputOpen)で制御し、
    // 締切(inputOpen=false)後は会員は変更不可（確定/解除・修正はすべて許可中のみ）。スタッフは常時可。
    match /blindGuesses/{id} {
      allow read: if signedIn();
      allow create: if isStaff()
        || (realUser() && request.resource.data.authUid == request.auth.uid && flightInputOpen(request.resource.data.batchId));
      allow update: if isStaff()
        || (realUser() && resource.data.authUid == request.auth.uid && flightInputOpen(resource.data.batchId));
      allow delete: if isStaff();
    }
    // ブラインド: 結果公開のフラグ（バッチ単位）。店側が公開、全端末が閲覧。
    match /blindFlights/{id} { allow read: if signedIn(); allow write: if isStaff(); }
    match /memberBadges/{id}  { allow read: if signedIn(); allow write: if isStaff(); }
    match /counters/{id}      { allow read, write: if isStaff(); }
    match /sessions/{id}      { allow read: if true;       allow write: if isStaff(); }
    match /storeStatus/{id}   { allow read: if true;       allow write: if isStaff(); }

    // ── 公開ポータル（index.html / news.html が未認証で読む） ──
    match /news/{id}           { allow read: if true; allow write: if isOwner(); }
    match /newsConfig/{id}     { allow read: if true; allow write: if isOwner(); }
    match /schedules/{id}      { allow read: if true; allow write: if isOwner(); }
    match /layouts/{id}        { allow read: if true; allow write: if isOwner(); }
    match /publicProfiles/{id} { allow read: if true; allow write: if isStaff(); }

    // ── テキーラBAR・地理マスタ（個人テキーラログの場所参照）──
    // 認証会員がログの場所選択で参照するため read は認証済みに開放、書込はオーナー。
    // BAR: 認証会員は閲覧可。オーナーは全操作。
    // 会員は「承認待ち(status=pending)」の新規BARのみ申請作成できる（本人UIDを固定）。
    // 承認（status変更）・編集・削除はオーナーのみ。
    match /bars/{id} {
      allow read: if signedIn();
      allow create: if isOwner()
        || (realUser()
            && request.resource.data.get('status', '') == 'pending'
            && request.resource.data.get('createdByUid', '') == request.auth.uid
            && request.resource.data.keys().hasOnly(
                 ['barId', 'nameJa', 'nameEn', 'nameEs', 'nameKana',
                  'countryId', 'regionId', 'cityId', 'postalCode', 'address',
                  'phoneCountryCode', 'phone', 'reviewUrl', 'mapUrl',
                  'lat', 'lng', 'elevation', 'status',
                  'createdByUid', 'createdByName', 'createdAt', 'updatedAt']));
      allow update, delete: if isOwner();
    }
    match /countries/{id} { allow read: if signedIn(); allow write: if isOwner(); }
    match /regions/{id}   { allow read: if signedIn(); allow write: if isOwner(); }
    match /cities/{id}    { allow read: if signedIn(); allow write: if isOwner(); }

    // ── 設定: memberCounter の採番はスタッフ（checkinのゲスト採番）と
    //    Functions（registerMember）のみ。realSeq巻き戻しは禁止 ──
    // 来店QRトークン: 会員には読ませない（読めると物理来店なしにリクエスト偽装可能）。
    // 表示はスタッフのみ、再発行は Cloud Function（rotateCheckinToken）が行う。
    match /settings/checkinConfig {
      allow read: if isStaff();
      allow write: if isOwner();
    }
    match /settings/memberCounter {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update: if isStaff()
        && request.resource.data.get('realSeq', 0) >= resource.data.get('realSeq', 0);
      allow delete: if isOwner();
    }
    // 店内温湿度: 公開TOP(index.html・未ログイン)で表示するため公開読取。
    // 書込は refreshEnvSensor(Cloud Functions/admin SDK)のみ。機微情報ではない。
    match /settings/envSensor {
      allow read: if true;
      allow write: if false;
    }
    match /settings/{id} {
      allow read: if signedIn();
      allow write: if isOwner();
    }

    // 地図の市町村ドットキャッシュ: 閲覧クライアントがオンデマンド生成する
    match /dotMunicipios/{id} { allow read, write: if signedIn(); }

    // 温湿度の毎時ログ: 閲覧はスタッフのみ、書込はCloud Functions(admin SDK)のみ
    match /envLog/{id} { allow read: if isStaff(); allow write: if false; }

    // ── マスタデータ: 認証済みなら読み取り可（匿名含む）・書き込みはオーナー ──
    match /bottles/{id}        { allow read: if signedIn(); allow write: if isOwner(); }
    match /bottleData/{id}     {
      allow read: if signedIn();
      // 通常のボトルデータ作成/削除は owner。スタッフはキープ購入で作成するボトルデータ
      // （lotNo=='KEEP'）のみ作成可（マスタ管理そのものは owner 限定を維持）。
      allow create: if isOwner()
        || (isStaff() && request.resource.data.get('lotNo', '') == 'KEEP');
      allow delete: if isOwner();
      // 通常編集は owner。スタッフはキープボトル購入時の在庫状態更新のみ許可（status/visibility）。
      allow update: if isOwner()
        || (isStaff() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','visibility','updatedAt']));
    }
    match /brands/{id}         { allow read: if signedIn(); allow write: if isOwner(); }
    match /classes/{id}        { allow read: if signedIn(); allow write: if isOwner(); }
    match /distilleries/{id}   { allow read: if signedIn(); allow write: if isOwner(); }
    match /districts/{id}      { allow read: if signedIn(); allow write: if isOwner(); }
    match /locations/{id}      { allow read: if signedIn(); allow write: if isOwner(); }
    match /mapOverlays/{id}    { allow read: if signedIn(); allow write: if isOwner(); }
    match /cocktailMaster/{id} { allow read: if signedIn(); allow write: if isOwner(); }
    match /subMaterials/{id}   { allow read: if signedIn(); allow write: if isOwner(); }
    match /setProducts/{id}    { allow read: if signedIn(); allow write: if isOwner(); }
    match /miscProducts/{id}   { allow read: if signedIn(); allow write: if isOwner(); }
    match /otherBottles/{id}   { allow read: if signedIn(); allow write: if isOwner(); }
    match /blindMarks/{id}     { allow read: if signedIn(); allow write: if isOwner(); }
    match /badges/{id}         { allow read: if signedIn(); allow write: if isOwner(); }
    match /videos360/{id}      { allow read: if signedIn(); allow write: if isOwner(); }
    // 会員書庫（テキーラ規格などの対訳文書）: 会員は閲覧のみ、編集はスタッフ。章はサブコレクション。
    match /libraryDocs/{doc} {
      allow read: if signedIn();
      allow write: if isStaff();
      match /chapters/{ch} {
        allow read: if signedIn();
        allow write: if isStaff();
      }
    }
    match /plans/{id}          { allow read: if signedIn(); allow write: if isOwner(); }
    // 有料セミナー: メタ情報は会員閲覧可・書込オーナー。
    // 動画ソース(vimeoId)は会員から読めない（Function getSeminarVideo が検証後に返す）。
    // 購入記録もクライアントからは読めない（Function getMyPurchasedSeminars 経由）。
    match /seminars/{id}        { allow read: if signedIn(); allow write: if isOwner(); }
    match /seminarSources/{id}  { allow read: if isOwner(); allow write: if isOwner(); }
    match /seminarPurchases/{id}{ allow read: if isStaff();  allow write: if isOwner(); }
    match /products/{id}       { allow read: if signedIn(); allow write: if isOwner(); }
    match /masterMeta/{id}     { allow read: if signedIn(); allow write: if isOwner(); }

    // ── AMM/PTD データ（会員のPTDデータ閲覧 member_ptd.html が読む）:
    //    認証済み会員は読み取り可・書き込みはオーナーのみ ──
    match /ammDistilleries/{id}       { allow read: if signedIn(); allow write: if isOwner(); }
    match /ammDistilleryDetails/{id}  { allow read: if signedIn(); allow write: if isOwner(); }
    match /ammBottleDetails/{id}      { allow read: if signedIn(); allow write: if isOwner(); }
    match /ammRankingHistory/{id}     { allow read: if signedIn(); allow write: if isOwner(); }

    // ── その他（miscKinds, otherCat*, badgeTypes, calMeta, crt*,
    //    crtCountryMap, adminOps など管理ページ専用）: オーナーのみ ──
    match /{document=**} {
      allow read, write: if isOwner();
    }
  }
}
